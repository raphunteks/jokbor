      <div class="glass-panel rounded-3xl p-6 sm:p-14 relative overflow-hidden border border-white/10">
        
        <div class="grid lg:grid-cols-12 gap-8 sm:gap-10 items-center">
          
          <div class="lg:col-span-7">
            <span class="inline-block px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-300 font-bold text-[10px] sm:text-xs uppercase tracking-wider mb-4">
              <%= content.tentang.badge %>
            </span>
            <h2 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight mb-4 sm:mb-6">
              <%= content.tentang.title %>
            </h2>
            <p class="text-slate-300 text-xs sm:text-sm lg:text-base leading-relaxed mb-4">
              <%= content.tentang.p1 %>
            </p>
            <p class="text-slate-300 text-xs sm:text-sm lg:text-base leading-relaxed mb-6">
              <%= content.tentang.p2 %>
            </p>
            
            <div class="flex flex-wrap gap-2.5 sm:gap-4 text-[10px] sm:text-xs font-semibold text-slate-300">
              <div class="flex items-center gap-2 bg-white/5 px-3 py-2 rounded-xl border border-white/10">
                <i class="fas fa-check-circle text-teal-400"></i> Standar SOAP Klinis
              </div>
              <div class="flex items-center gap-2 bg-white/5 px-3 py-2 rounded-xl border border-white/10">
                <i class="fas fa-check-circle text-cyan-400"></i> Format Laporan Terstandar
              </div>
              <div class="flex items-center gap-2 bg-white/5 px-3 py-2 rounded-xl border border-white/10">
                <i class="fas fa-check-circle text-indigo-400"></i> Garansi Revisi
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 flex justify-center w-full mt-6 lg:mt-0">
            <div class="w-full max-w-sm rounded-3xl p-5 sm:p-6 glass-card border-cyan-500/30 relative">
              <div class="text-center pb-4 border-b border-white/10">
                <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto rounded-2xl bg-gradient-to-tr from-teal-500 to-cyan-400 p-[2px] mb-3 shadow-lg shadow-cyan-500/30">
                  <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center">
                    <img src="/img/jokiborang.png" alt="Profile Joki Borang PIDGI" class="w-full h-full object-cover rounded-[14px]" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-3xl\'>🦷</span>';">
                  </div>
                </div>
                <h3 class="font-bold text-white text-sm sm:text-base">@jokiborangpidgi</h3>
                <p class="text-[10px] sm:text-xs text-cyan-400 mt-0.5">Asisten Logbook Terpercaya</p>
              </div>
              <div class="pt-4 space-y-3 text-[10px] sm:text-xs text-slate-300">
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">Target Pelayanan:</span>
                  <span class="font-semibold text-white">Stase RS & PKM</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">Kecepatan Respon:</span>
                  <span class="font-semibold text-teal-400">&lt; 15 Menit</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">Privasi Akun Portal:</span>
                  <span class="font-semibold text-emerald-400">Terenkripsi 100%</span>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <section id="keunggulan" class="py-16 sm:py-24 px-4 sm:px-6 relative z-10 bg-slate-950/40 border-y border-white/5 w-full">
    <div class="max-w-6xl mx-auto w-full">
      
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16 px-2">
        <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 font-bold text-[10px] sm:text-xs uppercase tracking-wider">
          <%= content.keunggulan.badge %>
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white mt-4">
          <%= content.keunggulan.title %>
        </h2>
        <p class="text-slate-400 text-xs sm:text-sm mt-3">
          <%= content.keunggulan.desc %>
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 w-full">
        
        <div class="glass-card p-6 sm:p-8 rounded-3xl w-full">
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-teal-500/20 text-teal-400 flex items-center justify-center text-xl sm:text-2xl mb-5 sm:mb-6 shadow-inner">
            <i class="fas fa-tooth"></i>
          </div>
          <h3 class="font-bold text-base sm:text-lg text-white mb-2 sm:mb-2.5">Paham Istilah & Kode ICD-10 Gigi</h3>
          <p class="text-[11px] sm:text-xs text-slate-400 leading-relaxed">
            Tidak asal ketik. Kami memahami terminologi odontologi, penulisan status lokalis, prosedur konservasi, bedah mulut, serta kode ICD-10 gigi yang valid.
          </p>
        </div>

        <div class="glass-card p-6 sm:p-8 rounded-3xl w-full">
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-xl sm:text-2xl mb-5 sm:mb-6 shadow-inner">
            <i class="fas fa-user-shield"></i>
          </div>
          <h3 class="font-bold text-base sm:text-lg text-white mb-2 sm:mb-2.5">Kerahasiaan Data 100%</h3>
          <p class="text-[11px] sm:text-xs text-slate-400 leading-relaxed">
            Privasi akun e-Logbook, nama wahana, nomor registrasi pasien, dan identitas dokter internsip dijamin aman dengan protokol pembersihan data berkala.
          </p>
        </div>

        <div class="glass-card p-6 sm:p-8 rounded-3xl w-full">
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-xl sm:text-2xl mb-5 sm:mb-6 shadow-inner">
            <i class="fas fa-bolt"></i>
          </div>
          <h3 class="font-bold text-base sm:text-lg text-white mb-2 sm:mb-2.5">Pengerjaan Tepat Waktu</h3>
          <p class="text-[11px] sm:text-xs text-slate-400 leading-relaxed">
            Komitmen deadline ketat. Tersedia opsi Reguler (3-5 hari) hingga layanan Express (1x24 jam) saat menghadapi batas akhir monev bulanan.
          </p>
        </div>

        <div class="glass-card p-6 sm:p-8 rounded-3xl w-full">
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl sm:text-2xl mb-5 sm:mb-6 shadow-inner">
            <i class="fas fa-clipboard-check"></i>
          </div>
          <h3 class="font-bold text-base sm:text-lg text-white mb-2 sm:mb-2.5">Format Standar Approval DP</h3>
          <p class="text-[11px] sm:text-xs text-slate-400 leading-relaxed">
            Penyusunan format SOAP, kegiatan promkes, dan laporan evaluasi telah disesuaikan agar mudah diverifikasi dan disetujui Dokter Pendamping.
          </p>
