                  const isHighlight = index === 2; // Paket Hemat
                  const bgClass = isHighlight ? 'bg-indigo-950/30 border border-indigo-500/30' : 'bg-white/5';
                %>
                  <div class="flex justify-between items-center p-2 sm:p-2.5 rounded-xl <%= bgClass %> text-[11px] sm:text-xs">
                    <% if (item?.note) { %>
                      <div>
                        <span class="<%= isHighlight ? 'font-semibold text-indigo-300' : 'text-slate-200 block' %>"><%= item?.name || '' %></span>
                        <span class="text-[9px] sm:text-[10px] text-slate-400"><%= item?.note || '' %></span>
                      </div>
                    <% } else { %>
                      <span class="<%= isHighlight ? 'font-semibold text-indigo-300' : 'text-slate-200' %>"><%= item?.name || '' %></span>
                    <% } %>
                    
                    <span class="font-bold text-white <%= isHighlight ? 'text-xs sm:text-sm' : '' %>"><%= item?.price || '' %></span>
                  </div>
                <% }); %>
              </div>
            </div>

            <a href="https://wa.me/<%= whatsappNumber %>?text=Halo%20Admin,%20saya%20mau%20order%20Penyusunan%20Laporan%20Kasus%20Lapsus" target="_blank" rel="noopener noreferrer" aria-label="Order Modul Laporan Kasus Lapsus" class="block w-full text-center py-3 rounded-xl bg-white/5 hover:bg-indigo-500 text-white font-bold text-[11px] sm:text-xs transition duration-200">
              Order Modul Lapsus
            </a>
          </div>

        </div>

      </div>
    </section>

    <section id="faq" aria-labelledby="faq-heading" class="py-16 sm:py-24 px-4 sm:px-6 relative z-10 bg-slate-950/40 border-t border-white/5 w-full">
      <div class="max-w-4xl mx-auto w-full">
        
        <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16 px-2">
          <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 font-bold text-[10px] sm:text-xs uppercase tracking-wider">
            <%= content?.faq?.badge || '' %>
          </span>
          <h2 id="faq-heading" class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white mt-4">
            <%= content?.faq?.title || '' %>
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm mt-3">
            <%= content?.faq?.desc || '' %>
          </p>
        </div>

        <div class="space-y-3 sm:space-y-4">
          <% (content?.faq?.items || []).forEach(function(item) { %>
            <details class="glass-card rounded-2xl p-5 sm:p-6 cursor-pointer group transition-all w-full">
              <summary class="font-bold text-[13px] sm:text-base text-white flex justify-between items-center outline-none">
                <span class="pr-4"><%= item?.q || '' %></span>
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-cyan-400 transition-transform duration-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </summary>
              <div class="text-[11px] sm:text-sm text-slate-300 mt-4 leading-relaxed border-t border-white/10 pt-4">
                <%= item?.a || '' %>
              </div>
            </details>
          <% }); %>
        </div>

      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 py-10 sm:py-12 px-4 sm:px-6 relative z-10 bg-brand-dark w-full">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-5 sm:gap-6">
      
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-gradient-to-tr from-teal-500 to-cyan-400 p-[1px]">
          <div class="w-full h-full bg-slate-950 rounded-[11px] flex items-center justify-center">
            <img src="/img/jokiborang.png" alt="Logo <%= content?.brand?.title || 'jokiborangpidgi' %>" loading="lazy" decoding="async" class="w-full h-full object-cover rounded-[11px]" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-lg\'>🦷</span>';">
          </div>
        </div>
        <span class="font-extrabold text-sm tracking-tight text-white"><%= content?.brand?.title || 'jokiborangpidgi' %></span>
      </div>

      <div class="text-[10px] sm:text-xs text-slate-300 text-center px-4 md:px-0 leading-relaxed">
        <div class="text-[10px] sm:text-xs text-slate-300 text-center px-4 md:px-0 leading-relaxed">&copy; <%= currentYear %> <strong><%= content?.footer?.copyText || '@jokiborangpidgi. Seluruh Hak Cipta Dilindungi. Partner Administrasi Dokter Gigi Internsip Indonesia.' %></strong></div>
      </div>

      <div class="flex items-center gap-4 text-slate-300 text-sm">
        <a href="<%= content?.footer?.instagram || 'https://instagram.com/jokiborangpidgi' %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram <%= content?.brand?.title || 'jokiborangpidgi' %>" class="hover:text-pink-400 transition-colors">
          <i class="fab fa-instagram text-lg sm:text-xl" aria-hidden="true"></i>
        </a>
        <a href="https://wa.me/<%= whatsappNumber %>" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Admin Utama" class="hover:text-emerald-400 transition-colors">
          <i class="fab fa-whatsapp text-lg sm:text-xl" aria-hidden="true"></i>
        </a>
      </div>

    </div>
  </footer>

  <aside aria-label="Kontak Cepat Floating" class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50">
    <a href="https://wa.me/<%= whatsappNumber %>?text=Halo%20Admin%20<%= encodeURIComponent(content?.brand?.title || 'jokiborangpidgi') %>,%20saya%20ingin%20tanya%20jasa%20borang" target="_blank" rel="noopener noreferrer" aria-label="Chat WhatsApp Admin Cepat" class="flex items-center gap-2 sm:gap-3 px-4 sm:px-5 py-3 sm:py-3.5 rounded-full bg-emerald-700 hover:bg-emerald-600 text-white font-bold text-xs shadow-2xl shadow-emerald-500/40 hover:scale-105 active:scale-95 transition duration-200">
      <i class="fab fa-whatsapp text-base sm:text-lg" aria-hidden="true"></i>
      <span class="hidden sm:inline"><%= content?.brand?.ctaWhatsapp || 'Chat Admin Sekarang' %></span>
    </a>
  </aside>

  <script>
    (function () {
      const menuBtn = document.getElementById('mobileMenuBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      const menuIcon = document.getElementById('menuIcon');

      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          const isHidden = mobileMenu.classList.contains('hidden');

          if (isHidden) {
            mobileMenu.classList.remove('hidden');
            menuBtn.setAttribute('aria-expanded', 'true');
            menuIcon.classList.remove('fa-ellipsis-vertical');
            menuIcon.classList.add('fa-xmark');
          } else {
            mobileMenu.classList.add('hidden');
            menuBtn.setAttribute('aria-expanded', 'false');
            menuIcon.classList.remove('fa-xmark');
            menuIcon.classList.add('fa-ellipsis-vertical');
          }
        });

        document.addEventListener('click', function (e) {
          if (!mobileMenu.contains(e.target) && !menuBtn.contains(e.target) && !mobileMenu.classList.contains('hidden')) {
            mobileMenu.classList.add('hidden');
            menuBtn.setAttribute('aria-expanded', 'false');
            menuIcon.classList.remove('fa-xmark');
            menuIcon.classList.add('fa-ellipsis-vertical');
          }
        });
      }
    })();
  </script>

  <script>
    (function () {
      const activeSection = "<%= currentSection %>";
      if (activeSection && activeSection !== 'home' && activeSection !== 'hero') {
        window.addEventListener('DOMContentLoaded', function () {
          setTimeout(function () {
            const targetElement = document.getElementById(activeSection);
            if (targetElement) {
              const navOffset = 80;
              const elementPosition = targetElement.getBoundingClientRect().top;
              const offsetPosition = elementPosition + window.pageYOffset - navOffset;
              window.scrollTo({
                top: offsetPosition,
                behavior: 'smooth'
              });
            }
          }, 100);
        });
      }
    })();
  </script>

  <script defer src="/js/protect-devtools.js"></script>

</body>
</html>
