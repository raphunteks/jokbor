<!DOCTYPE html>
<html lang="id" class="scroll-smooth overflow-x-hidden">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <meta name="google-site-verification" content="cbSE7olGd0ibEx_bhjC3aitjIovXCSwUKYbVOh7nbLs" />

  <title><%= seo?.title || 'Joki Borang PIDGI' %></title>
  <meta name="description" content="<%= seo?.description || '' %>">
  <meta name="keywords" content="<%= seo?.keywords || '' %>">
  <meta name="author" content="<%= content?.brand?.title || 'jokiborangpidgi' %>">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <link rel="canonical" href="<%= seo?.canonicalUrl || '' %>">

  <meta name="geo.region" content="ID">
  <meta name="geo.placename" content="Indonesia">
  <meta name="language" content="Indonesian">
  <meta http-equiv="content-language" content="id">

  <!-- [SUPER UPGRADE] Agentic WebMCP Link (Lulus Audit Agentic 3/3) -->
  <link rel="alternate" type="application/llms+txt" href="/llms.txt">

  <!-- [SUPER UPGRADE] Performa FCP & LCP Desktop: Preconnect & Preload Script -->
  <link rel="preconnect" href="https://cdn.tailwindcss.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="dns-prefetch" href="https://cdn.tailwindcss.com">
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
  <link rel="preload" href="/img/jokiborang.png" as="image" type="image/png" fetchpriority="high">
  <link rel="preload" href="https://cdn.tailwindcss.com" as="script">

  <link rel="icon" type="image/png" href="/img/jokiborang.png">
  <link rel="shortcut icon" type="image/png" href="/img/jokiborang.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/jokiborang.png">
  <meta name="theme-color" content="#070b14">
  <meta name="msapplication-TileColor" content="#070b14">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

  <meta property="og:type" content="<%= seo?.ogType || 'website' %>">
  <meta property="og:url" content="<%= seo?.canonicalUrl || '' %>">
  <meta property="og:title" content="<%= seo?.title || '' %>">
  <meta property="og:description" content="<%= seo?.description || '' %>">
  <meta property="og:image" content="<%= seo?.ogImage || '' %>">
  <meta property="og:image:secure_url" content="<%= seo?.ogImage || '' %>">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="512">
  <meta property="og:image:height" content="512">
  <meta property="og:image:alt" content="<%= content?.brand?.title || 'Joki Borang PIDGI' %> - Layanan Input Logbook Dokter Gigi Internsip">
  <meta property="og:site_name" content="<%= content?.brand?.title || 'jokiborangpidgi' %>">
  <meta property="og:locale" content="id_ID">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="<%= seo?.canonicalUrl || '' %>">
  <meta name="twitter:title" content="<%= seo?.title || '' %>">
  <meta name="twitter:description" content="<%= seo?.description || '' %>">
  <meta name="twitter:image" content="<%= seo?.ogImage || '' %>">
  <meta name="twitter:image:alt" content="<%= content?.brand?.title || 'Joki Borang PIDGI' %> Logo">
  <meta name="twitter:site" content="@jokiborangpidgi">
  <meta name="twitter:creator" content="@jokiborangpidgi">

  <script type="application/ld+json">
  <%- JSON.stringify(seo?.schemaJson || {}) %>
  </script>

  <!-- Tailwind Script Loader (HARUS DI ATAS CONFIG AGAR WARNA TIDAK PUTIH) -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              teal: '#0d9488',
              cyan: '#06b6d4',
              indigo: '#6366f1',
              dark: '#070b14',
              slate: '#0f172a'
            }
          },
          animation: {
            'scroll-x': 'scroll-x 40s linear infinite',
            'scroll-x-reverse': 'scroll-x-reverse 40s linear infinite',
          },
          keyframes: {
            'scroll-x': {
              '0%': { transform: 'translateX(0)' },
              '100%': { transform: 'translateX(-50%)' },
            },
            'scroll-x-reverse': {
              '0%': { transform: 'translateX(-50%)' },
              '100%': { transform: 'translateX(0)' },
            }
          }
        }
      }
    }
  </script>
  
  <!-- [UPGRADE] Performa: Defer non-critical CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></noscript>
  <link rel="stylesheet" href="/css/main.css">

  <!-- Vercel Speed Insights -->
  <script>
    window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/speed-insights/script.js"></script>
</head>
<body class="bg-brand-dark text-slate-100 antialiased selection:bg-cyan-500 selection:text-white relative overflow-x-hidden max-w-[100vw] w-full">

  <!-- Background Decorative -->
  <div class="fixed inset-0 w-full h-full overflow-hidden pointer-events-none -z-10" aria-hidden="true">
    <div class="mesh-glow mesh-teal w-[600px] h-[600px] absolute top-[-100px] left-[-150px]"></div>
    <div class="mesh-glow mesh-cyan w-[500px] h-[500px] absolute top-[40%] right-[-100px]"></div>
    <div class="mesh-glow mesh-indigo w-[700px] h-[700px] absolute bottom-[10%] left-[10%]"></div>
  </div>

  <header class="fixed top-0 left-0 w-full z-50 glass-nav">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between" aria-label="Navigasi Utama">
      
      <a href="/" class="flex items-center gap-3 group" title="Beranda <%= content?.brand?.title || 'Joki Borang PIDGI' %>" aria-label="Beranda <%= content?.brand?.title || '' %>">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-teal-500 via-cyan-400 to-indigo-500 p-[1px] shadow-lg shadow-cyan-500/20 shrink-0">
          <div class="w-full h-full bg-slate-950 rounded-[15px] flex items-center justify-center overflow-hidden">
            <img src="/img/jokiborang.png" alt="Logo <%= content?.brand?.title || 'jokiborangpidgi' %>" fetchpriority="high" decoding="async" class="w-full h-full object-cover group-hover:scale-110 transition duration-300" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-xl\'>🦷</span>';">
          </div>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-base sm:text-lg tracking-tight bg-gradient-to-r from-teal-300 via-cyan-200 to-white bg-clip-text text-transparent truncate">
            <%= content?.brand?.title || 'jokiborangpidgi' %>
          </span>
          <span class="text-[9px] sm:text-[10px] text-cyan-400 font-semibold tracking-wider uppercase"><%= content?.brand?.subtitle || 'PIDGI Assistance' %></span>
        </div>
      </a>

      <div class="hidden lg:flex items-center gap-8 text-sm font-medium">
        <a href="/tentang" class="<%= currentSection === 'tentang' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-200 hover:text-cyan-400 transition-colors' %>">Tentang</a>
        <a href="/keunggulan" class="<%= currentSection === 'keunggulan' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-200 hover:text-cyan-400 transition-colors' %>">Keunggulan</a>
        <a href="/layanan" class="<%= currentSection === 'layanan' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-200 hover:text-cyan-400 transition-colors' %>">Layanan</a>
        <a href="/testimoni" class="<%= currentSection === 'testimoni' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-200 hover:text-cyan-400 transition-colors' %>">Testimoni</a>
        <a href="/biaya" class="<%= currentSection === 'biaya' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-200 hover:text-cyan-400 transition-colors' %>">Pricelist</a>
        <a href="/faq" class="<%= currentSection === 'faq' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-200 hover:text-cyan-400 transition-colors' %>">FAQ</a>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <a href="https://wa.me/<%= whatsappNumber %>?text=Halo%20Admin%20<%= encodeURIComponent(content?.brand?.title || 'jokiborangpidgi') %>,%20saya%20mau%20konsultasi%20jasa%20input%20borang%20PIDGI" target="_blank" rel="noopener noreferrer" aria-label="Konsultasi via WhatsApp" class="hidden sm:flex px-4 sm:px-5 py-2.5 rounded-full bg-gradient-to-r from-teal-700 to-cyan-700 text-white font-bold text-xs tracking-wide shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:scale-105 active:scale-95 transition duration-200 items-center gap-2">
          <i class="fab fa-whatsapp text-sm" aria-hidden="true"></i>
          <span><%= content?.brand?.ctaWhatsapp || 'Hubungi Kami' %></span>
        </a>

        <button id="mobileMenuBtn" aria-label="Buka Menu Navigasi" aria-expanded="false" aria-controls="mobileMenu" class="lg:hidden w-10 h-10 sm:w-11 sm:h-11 rounded-xl sm:rounded-2xl glass-card flex items-center justify-center text-cyan-400 hover:text-white hover:border-cyan-400/50 active:scale-95 transition duration-200 focus:outline-none shadow-lg shadow-cyan-500/10">
          <i id="menuIcon" class="fas fa-ellipsis-vertical text-lg sm:text-xl transition-transform duration-300" aria-hidden="true"></i>
        </button>
      </div>

    </nav>

    <div id="mobileMenu" class="hidden lg:hidden glass-mobile-menu border-b border-white/10 px-4 sm:px-6 py-4 sm:py-6 transition-all duration-300 shadow-2xl overflow-y-auto max-h-[85vh]">
      <div class="flex flex-col gap-2.5 text-sm font-medium">
        <a href="/tentang" class="flex items-center justify-between px-4 py-3 rounded-xl transition duration-200 <%= currentSection === 'tentang' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 font-bold' : 'text-slate-200 hover:bg-white/5 hover:text-cyan-400' %>">
          <span>Tentang Kami</span>
          <i class="fas fa-chevron-right text-xs opacity-50" aria-hidden="true"></i>
        </a>
        <a href="/keunggulan" class="flex items-center justify-between px-4 py-3 rounded-xl transition duration-200 <%= currentSection === 'keunggulan' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 font-bold' : 'text-slate-200 hover:bg-white/5 hover:text-cyan-400' %>">
          <span>Keunggulan Layanan</span>
          <i class="fas fa-chevron-right text-xs opacity-50" aria-hidden="true"></i>
        </a>
        <a href="/layanan" class="flex items-center justify-between px-4 py-3 rounded-xl transition duration-200 <%= currentSection === 'layanan' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 font-bold' : 'text-slate-200 hover:bg-white/5 hover:text-cyan-400' %>">
          <span>Modul & Layanan</span>
          <i class="fas fa-chevron-right text-xs opacity-50" aria-hidden="true"></i>
        </a>
        <a href="/testimoni" class="flex items-center justify-between px-4 py-3 rounded-xl transition duration-200 <%= currentSection === 'testimoni' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 font-bold' : 'text-slate-200 hover:bg-white/5 hover:text-cyan-400' %>">
          <span>Testimoni Klien</span>
          <i class="fas fa-chevron-right text-xs opacity-50" aria-hidden="true"></i>
        </a>
        <a href="/biaya" class="flex items-center justify-between px-4 py-3 rounded-xl transition duration-200 <%= currentSection === 'biaya' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 font-bold' : 'text-slate-200 hover:bg-white/5 hover:text-cyan-400' %>">
          <span>Daftar Harga (Pricelist)</span>
          <i class="fas fa-chevron-right text-xs opacity-50" aria-hidden="true"></i>
        </a>
        <a href="/faq" class="flex items-center justify-between px-4 py-3 rounded-xl transition duration-200 <%= currentSection === 'faq' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 font-bold' : 'text-slate-200 hover:bg-white/5 hover:text-cyan-400' %>">
          <span>FAQ Tanya Jawab</span>
          <i class="fas fa-chevron-right text-xs opacity-50" aria-hidden="true"></i>
        </a>

        <div class="pt-3 mt-2 border-t border-white/10 sm:hidden">
          <a href="https://wa.me/<%= whatsappNumber %>?text=Halo%20Admin%20<%= encodeURIComponent(content?.brand?.title || 'jokiborangpidgi') %>,%20saya%20mau%20konsultasi%20jasa%20input%20borang%20PIDGI" target="_blank" rel="noopener noreferrer" aria-label="Konsultasi WhatsApp Sekarang" class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-teal-700 to-cyan-700 text-white font-bold text-xs tracking-wide shadow-lg shadow-cyan-500/25 flex items-center justify-center gap-2">
            <i class="fab fa-whatsapp text-base" aria-hidden="true"></i>
            <span><%= content?.brand?.ctaWhatsapp || 'Konsultasi WhatsApp Sekarang' %></span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- [SUPER UPGRADE] SSR Hardening dengan Optional Chaining & Fallbacks -->
  <main id="main-content" class="w-full">
    
    <section id="hero" aria-labelledby="hero-heading" class="relative pt-32 pb-20 md:pt-44 md:pb-32 px-4 sm:px-6 z-10 w-full">
      <div class="max-w-6xl mx-auto text-center w-full">
        
        <div class="inline-flex items-center gap-2.5 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full glass-card border border-teal-500/30 text-teal-300 text-[10px] sm:text-xs font-semibold mb-6 sm:mb-8 shadow-inner max-w-full overflow-hidden">
          <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-cyan-400 animate-pulse shrink-0" aria-hidden="true"></span>
          <span class="truncate"><%= content?.hero?.badge || '' %></span>
        </div>

        <h1 id="hero-heading" class="text-3xl sm:text-5xl lg:text-7xl font-black tracking-tight leading-[1.2] sm:leading-[1.15] mb-6 sm:mb-8 px-2 sm:px-0">
          <%= content?.hero?.titleMain || '' %> <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-teal-400 via-cyan-300 to-indigo-300 bg-clip-text text-transparent">
            <%= content?.hero?.titleHighlight || '' %>
          </span>
        </h1>

        <p class="text-slate-200 text-sm sm:text-base lg:text-xl max-w-3xl mx-auto mb-10 sm:mb-12 leading-relaxed font-normal px-2 sm:px-0">
          <%= content?.hero?.description || '' %>
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-12 sm:mb-16 w-full px-4 sm:px-0">
          <a href="/biaya" aria-label="Lihat Daftar Harga Layanan" class="w-full sm:w-auto px-6 sm:px-8 py-3.5 sm:py-4 rounded-2xl bg-gradient-to-r from-teal-500 to-cyan-500 text-white font-bold text-xs sm:text-sm shadow-xl shadow-teal-500/30 hover:shadow-cyan-500/50 hover:scale-105 active:scale-95 transition duration-200">
            <i class="fas fa-tags mr-2" aria-hidden="true"></i> <%= content?.hero?.ctaPrice || '' %>
          </a>
          <a href="/layanan" aria-label="Pelajari Modul Layanan" class="w-full sm:w-auto px-6 sm:px-8 py-3.5 sm:py-4 rounded-2xl glass-card text-slate-100 font-semibold text-xs sm:text-sm hover:bg-white/10 hover:text-white transition duration-200">
            <i class="fas fa-layer-group mr-2 text-cyan-400" aria-hidden="true"></i> <%= content?.hero?.ctaService || '' %>
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto w-full px-2 sm:px-0">
          <% (content?.hero?.stats || []).forEach(function(stat) { %>
            <div class="glass-card p-3 sm:p-4 rounded-2xl">
              <div class="text-xl sm:text-2xl font-black <%= stat?.color || 'text-cyan-400' %>"><%= stat?.value || '' %></div>
              <div class="text-[9px] sm:text-[11px] text-slate-300 uppercase font-semibold mt-1"><%= stat?.label || '' %></div>
            </div>
          <% }); %>
        </div>

      </div>
    </section>

    <section id="tentang" aria-labelledby="tentang-heading" class="py-16 sm:py-24 px-4 sm:px-6 relative z-10 w-full">
      <div class="max-w-6xl mx-auto w-full">
        <div class="glass-panel rounded-3xl p-6 sm:p-14 relative overflow-hidden border border-white/10">
          
          <div class="grid lg:grid-cols-12 gap-8 sm:gap-10 items-center">
            
            <div class="lg:col-span-7">
              <span class="inline-block px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-300 font-bold text-[10px] sm:text-xs uppercase tracking-wider mb-4">
                <%= content?.tentang?.badge || '' %>
              </span>
              <h2 id="tentang-heading" class="text-2xl sm:text-4xl font-extrabold text-white leading-tight mb-4 sm:mb-6">
                <%= content?.tentang?.title || '' %>
              </h2>
              <p class="text-slate-200 text-xs sm:text-sm lg:text-base leading-relaxed mb-4">
                <%= content?.tentang?.p1 || '' %>
              </p>
              <p class="text-slate-200 text-xs sm:text-sm lg:text-base leading-relaxed mb-6">
                <%= content?.tentang?.p2 || '' %>
              </p>
              
              <div class="flex flex-wrap gap-2.5 sm:gap-4 text-[10px] sm:text-xs font-semibold text-slate-200">
                <% (content?.tentang?.highlights || []).forEach(function(highlight, index) { 
                  const colors = ['text-teal-400', 'text-cyan-400', 'text-indigo-400'];
                  const color = colors[index % colors.length];
                %>
                  <div class="flex items-center gap-2 bg-white/5 px-3 py-2 rounded-xl border border-white/10">
                    <i class="fas fa-check-circle <%= color %>" aria-hidden="true"></i> <%= highlight %>
                  </div>
                <% }); %>
              </div>
            </div>

            <div class="lg:col-span-5 flex justify-center w-full mt-6 lg:mt-0">
              <div class="w-full max-w-sm rounded-3xl p-5 sm:p-6 glass-card border-cyan-500/30 relative">
                <div class="text-center pb-4 border-b border-white/10">
                  <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto rounded-2xl bg-gradient-to-tr from-teal-500 to-cyan-400 p-[2px] mb-3 shadow-lg shadow-cyan-500/30">
                    <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center">
                      <img src="/img/jokiborang.png" alt="Profile <%= content?.brand?.title || 'Joki Borang PIDGI' %>" loading="lazy" decoding="async" class="w-full h-full object-cover rounded-[14px]" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-3xl\'>🦷</span>';">
                    </div>
                  </div>
                  <h3 class="font-bold text-white text-sm sm:text-base"><%= content?.tentang?.profileCard?.handle || '' %></h3>
                  <p class="text-[10px] sm:text-xs text-cyan-400 mt-0.5"><%= content?.tentang?.profileCard?.subhandle || '' %></p>
                </div>
                <div class="pt-4 space-y-3 text-[10px] sm:text-xs text-slate-200">
                  <div class="flex justify-between items-center">
                    <span class="text-slate-300">Target Pelayanan:</span>
                    <span class="font-semibold text-white"><%= content?.tentang?.profileCard?.targetVal || '' %></span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-slate-300">Kecepatan Respon:</span>
                    <span class="font-semibold text-teal-400"><%= content?.tentang?.profileCard?.speedVal || '' %></span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-slate-300">Privasi Akun Portal:</span>
                    <span class="font-semibold text-emerald-400"><%= content?.tentang?.profileCard?.privacyVal || '' %></span>
                  </div>
                </div>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <section id="keunggulan" aria-labelledby="keunggulan-heading" class="py-16 sm:py-24 px-4 sm:px-6 relative z-10 bg-slate-950/40 border-y border-white/5 w-full">
      <div class="max-w-6xl mx-auto w-full">
        
        <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16 px-2">
          <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 font-bold text-[10px] sm:text-xs uppercase tracking-wider">
            <%= content?.keunggulan?.badge || '' %>
          </span>
          <h2 id="keunggulan-heading" class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white mt-4">
            <%= content?.keunggulan?.title || '' %>
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm mt-3">
            <%= content?.keunggulan?.desc || '' %>
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 w-full">
          <% (content?.keunggulan?.items || []).forEach(function(item) { %>
            <div class="glass-card p-6 sm:p-8 rounded-3xl w-full">
              <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl flex items-center justify-center text-xl sm:text-2xl mb-5 sm:mb-6 shadow-inner <%= item?.color || 'bg-cyan-500/20 text-cyan-400' %>">
                <i class="<%= item?.icon || 'fas fa-star' %>" aria-hidden="true"></i>
              </div>
              <h3 class="font-bold text-base sm:text-lg text-white mb-2 sm:mb-2.5"><%= item?.title || '' %></h3>
              <p class="text-[11px] sm:text-xs text-slate-300 leading-relaxed">
                <%= item?.desc || '' %>
              </p>
            </div>
          <% }); %>
        </div>

      </div>
    </section>

    <section id="layanan" aria-labelledby="layanan-heading" class="py-16 sm:py-24 px-4 sm:px-6 relative z-10 w-full">
