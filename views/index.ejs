          <i class="fas fa-chevron-right text-xs opacity-50"></i>
        </a>
        <a href="/keunggulan" class="flex items-center justify-between px-4 py-3 rounded-xl transition duration-200 <%= currentSection === 'keunggulan' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 font-bold' : 'text-slate-300 hover:bg-white/5 hover:text-cyan-400' %>">
          <span>Keunggulan Layanan</span>
          <i class="fas fa-chevron-right text-xs opacity-50"></i>
        </a>
        <a href="/layanan" class="flex items-center justify-between px-4 py-3 rounded-xl transition duration-200 <%= currentSection === 'layanan' ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 font-bold' : 'text-slate-300 hover:bg-white/5 hover:text-cyan-400' %>">
