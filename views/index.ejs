  <meta property="og:site_name" content="jokiborangpidgi">
  <meta property="og:locale" content="id_ID">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="<%= seo.canonicalUrl %>">
  <meta name="twitter:title" content="<%= seo.title %>">
  <meta name="twitter:description" content="<%= seo.description %>">
  <meta name="twitter:image" content="<%= seo.ogImage %>">
  <meta name="twitter:image:alt" content="Joki Borang PIDGI Logo">
  <meta name="twitter:site" content="@jokiborangpidgi">
  <meta name="twitter:creator" content="@jokiborangpidgi">

  <script type="application/ld+json">
  <%- JSON.stringify(seo.schemaJson) %>
  </script>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              teal: '#0d9488',
              cyan: '#06b6d4',
              indigo: '#6366f1',
              dark: '#070b14',
              slate: '#0f172a'
            }
          },
          animation: {
            'scroll-x': 'scroll-x 40s linear infinite',
            'scroll-x-reverse': 'scroll-x-reverse 40s linear infinite',
          },
          keyframes: {
            'scroll-x': {
              '0%': { transform: 'translateX(0)' },
              '100%': { transform: 'translateX(-50%)' },
            },
            'scroll-x-reverse': {
              '0%': { transform: 'translateX(-50%)' },
              '100%': { transform: 'translateX(0)' },
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-brand-dark text-slate-100 antialiased selection:bg-cyan-500 selection:text-white relative overflow-x-hidden max-w-[100vw] w-full">

