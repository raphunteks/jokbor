          <i class="fas fa-chevron-right text-xs opacity-50"></i>
        </a>

        <div class="pt-3 mt-2 border-t border-white/10 sm:hidden">
          <a href="https://wa.me/<%= whatsappNumber %>?text=Halo%20Admin%20jokiborangpidgi,%20saya%20mau%20konsultasi%20jasa%20input%20borang%20PIDGI" target="_blank" rel="noopener noreferrer" class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-teal-500 to-cyan-500 text-white font-bold text-xs tracking-wide shadow-lg shadow-cyan-500/25 flex items-center justify-center gap-2">
            <i class="fab fa-whatsapp text-base"></i>
            <span>Konsultasi WhatsApp Sekarang</span>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <section id="hero" class="relative pt-32 pb-20 md:pt-44 md:pb-32 px-4 sm:px-6 z-10 w-full">
    <div class="max-w-6xl mx-auto text-center w-full">
      
      <div class="inline-flex items-center gap-2.5 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full glass-card border border-teal-500/30 text-teal-300 text-[10px] sm:text-xs font-semibold mb-6 sm:mb-8 shadow-inner max-w-full overflow-hidden">
        <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-cyan-400 animate-pulse shrink-0"></span>
        <span class="truncate"><%= content.hero.badge %></span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-7xl font-black tracking-tight leading-[1.2] sm:leading-[1.15] mb-6 sm:mb-8 px-2 sm:px-0">
        <%= content.hero.titleMain %> <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-teal-400 via-cyan-300 to-indigo-300 bg-clip-text text-transparent">
          <%= content.hero.titleHighlight %>
        </span>
      </h1>

      <p class="text-slate-300 text-sm sm:text-base lg:text-xl max-w-3xl mx-auto mb-10 sm:mb-12 leading-relaxed font-normal px-2 sm:px-0">
