<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <!-- GOOGLE SITE VERIFICATION (GSC) -->
  <meta name="google-site-verification" content="cbSE7olGd0ibEx_bhjC3aitjIovXCSwUKYbVOh7nbLs" />

  <!-- DYNAMIC SSR SEO META TAGS (GOLD STANDARD GSC) -->
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <meta name="keywords" content="<%= seo.keywords %>">
  <meta name="author" content="jokiborangpidgi">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <link rel="canonical" href="<%= seo.canonicalUrl %>">

  <!-- REGIONAL & LANGUAGE TAGS -->
  <meta name="geo.region" content="ID">
  <meta name="geo.placename" content="Indonesia">
  <meta name="language" content="Indonesian">
  <meta http-equiv="content-language" content="id">

  <!-- FAVICON & TOUCH ICONS -->
  <link rel="icon" type="image/png" href="/img/jokiborang.png">
  <link rel="shortcut icon" type="image/png" href="/img/jokiborang.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/jokiborang.png">
  <meta name="theme-color" content="#070b14">
  <meta name="msapplication-TileColor" content="#070b14">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

  <!-- OPEN GRAPH / FACEBOOK (DYNAMIC SSR) -->
  <meta property="og:type" content="<%= seo.ogType %>">
  <meta property="og:url" content="<%= seo.canonicalUrl %>">
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:image" content="<%= seo.ogImage %>">
  <meta property="og:image:secure_url" content="<%= seo.ogImage %>">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="512">
  <meta property="og:image:height" content="512">
  <meta property="og:image:alt" content="Joki Borang PIDGI - Layanan Input Logbook Dokter Gigi Internsip">
  <meta property="og:site_name" content="jokiborangpidgi">
  <meta property="og:locale" content="id_ID">

  <!-- TWITTER CARDS (DYNAMIC SSR) -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="<%= seo.canonicalUrl %>">
  <meta name="twitter:title" content="<%= seo.title %>">
  <meta name="twitter:description" content="<%= seo.description %>">
  <meta name="twitter:image" content="<%= seo.ogImage %>">
  <meta name="twitter:image:alt" content="Joki Borang PIDGI Logo">
  <meta name="twitter:site" content="@jokiborangpidgi">
  <meta name="twitter:creator" content="@jokiborangpidgi">

  <!-- DYNAMIC STRUCTURED DATA / GOOGLE RICH RESULTS SCHEMA GRAPH (SSR) -->
  <script type="application/ld+json">
  <%- JSON.stringify(seo.schemaJson) %>
  </script>

  <!-- TAILWIND & ASSETS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              teal: '#0d9488',
              cyan: '#06b6d4',
              indigo: '#6366f1',
              dark: '#070b14',
              slate: '#0f172a'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-brand-dark text-slate-100 antialiased selection:bg-cyan-500 selection:text-white relative">

