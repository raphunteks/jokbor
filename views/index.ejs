      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="glass-card p-8 rounded-3xl">
          <div class="w-14 h-14 rounded-2xl bg-teal-500/20 text-teal-400 flex items-center justify-center text-2xl mb-6 shadow-inner">
