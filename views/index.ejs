<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <!-- DYNAMIC SSR SEO META TAGS (GOLD STANDARD GSC) -->
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <meta name="keywords" content="<%= seo.keywords %>">
  <meta name="author" content="jokiborangpidgi">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <link rel="canonical" href="<%= seo.canonicalUrl %>">

  <!-- FAVICON & TOUCH ICONS -->
  <link rel="icon" type="image/png" href="/img/jokiborang.png">
  <link rel="shortcut icon" type="image/png" href="/img/jokiborang.png">
  <link rel="apple-touch-icon" href="/img/jokiborang.png">
  <meta name="theme-color" content="#070b14">
  <meta name="msapplication-TileColor" content="#070b14">

  <!-- OPEN GRAPH / FACEBOOK (DYNAMIC SSR) -->
  <meta property="og:type" content="<%= seo.ogType %>">
  <meta property="og:url" content="<%= seo.canonicalUrl %>">
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:image" content="<%= seo.ogImage %>">
  <meta property="og:image:alt" content="Joki Borang PIDGI - Layanan Logbook Dokter Gigi Internsip">
  <meta property="og:site_name" content="jokiborangpidgi">
  <meta property="og:locale" content="id_ID">

  <!-- TWITTER CARDS (DYNAMIC SSR) -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="<%= seo.canonicalUrl %>">
  <meta name="twitter:title" content="<%= seo.title %>">
  <meta name="twitter:description" content="<%= seo.description %>">
  <meta name="twitter:image" content="<%= seo.ogImage %>">
  <meta name="twitter:site" content="@jokiborangpidgi">
  <meta name="twitter:creator" content="@jokiborangpidgi">

  <!-- JSON-LD STRUCTURED DATA / GOOGLE RICH RESULTS SCHEMA (SSR) -->
  <script type="application/ld+json">
  <%- JSON.stringify(seo.schemaJson) %>
  </script>

  <!-- TAILWIND & ASSETS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              teal: '#0d9488',
              cyan: '#06b6d4',
              indigo: '#6366f1',
              dark: '#070b14',
              slate: '#0f172a'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-brand-dark text-slate-100 antialiased selection:bg-cyan-500 selection:text-white relative">

  <!-- Decorative Mesh Gradients -->
  <div class="mesh-glow mesh-teal w-[600px] h-[600px] top-[-100px] left-[-150px]"></div>
  <div class="mesh-glow mesh-cyan w-[500px] h-[500px] top-[40%] right-[-100px]"></div>
  <div class="mesh-glow mesh-indigo w-[700px] h-[700px] bottom-[10%] left-[10%]"></div>

  <!-- NAVBAR -->
  <nav class="fixed top-0 left-0 w-full z-50 glass-nav">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      
      <!-- Brand Logo Links to Clean Root -->
      <a href="/" class="flex items-center gap-3 group" title="Beranda Joki Borang PIDGI">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-teal-500 via-cyan-400 to-indigo-500 p-[1px] shadow-lg shadow-cyan-500/20">
          <div class="w-full h-full bg-slate-950 rounded-[15px] flex items-center justify-center overflow-hidden">
            <img src="/img/jokiborang.png" alt="Logo jokiborangpidgi" class="w-full h-full object-cover group-hover:scale-110 transition duration-300" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-xl\'>🦷</span>';">
          </div>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-teal-300 via-cyan-200 to-white bg-clip-text text-transparent">
            jokiborangpidgi
          </span>
          <span class="text-[10px] text-cyan-400 font-semibold tracking-wider uppercase">PIDGI Assistance</span>
        </div>
      </a>

      <!-- Clean URL Navbar Links (Without Hash '#') with Dynamic SSR Active State -->
      <div class="hidden lg:flex items-center gap-8 text-sm font-medium">
        <a href="/tentang" class="<%= currentSection === 'tentang' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-300 hover:text-cyan-400 transition-colors' %>">Tentang</a>
        <a href="/keunggulan" class="<%= currentSection === 'keunggulan' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-300 hover:text-cyan-400 transition-colors' %>">Keunggulan</a>
        <a href="/layanan" class="<%= currentSection === 'layanan' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-300 hover:text-cyan-400 transition-colors' %>">Layanan</a>
        <a href="/testimoni" class="<%= currentSection === 'testimoni' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-300 hover:text-cyan-400 transition-colors' %>">Testimoni</a>
        <a href="/biaya" class="<%= currentSection === 'biaya' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-300 hover:text-cyan-400 transition-colors' %>">Pricelist</a>
        <a href="/faq" class="<%= currentSection === 'faq' ? 'text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1' : 'text-slate-300 hover:text-cyan-400 transition-colors' %>">FAQ</a>
      </div>

      <div class="flex items-center gap-3">
        <a href="https://wa.me/<%= whatsappNumber %>?text=Halo%20Admin%20jokiborangpidgi,%20saya%20mau%20konsultasi%20jasa%20input%20borang%20PIDGI" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-full bg-gradient-to-r from-teal-500 to-cyan-500 text-white font-bold text-xs tracking-wide shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:scale-105 active:scale-95 transition duration-200 flex items-center gap-2">
          <i class="fab fa-whatsapp text-sm"></i>
          <span>Hubungi Kami</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- PAGE 1: HERO SECTION -->
  <section id="hero" class="relative pt-36 pb-24 md:pt-44 md:pb-32 px-6 z-10">
    <div class="max-w-6xl mx-auto text-center">
      
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full glass-card border border-teal-500/30 text-teal-300 text-xs font-semibold mb-8 shadow-inner">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>Jasa Administrasi & Input Logbook PIDGI No. 1 di Indonesia</span>
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.15] mb-8">
        Fokus Tangani Pasien, <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-teal-400 via-cyan-300 to-indigo-300 bg-clip-text text-transparent">
          Biar Borang PIDGI Kami yang Tuntaskan.
        </span>
      </h1>

      <p class="text-slate-300 text-base sm:text-lg lg:text-xl max-w-3xl mx-auto mb-12 leading-relaxed font-normal">
        Solusi terpercaya pengisian e-logbook harian, stase Puskesmas, dan Rumah Sakit. Dari koding UKP, laporan UKM lapangan, hingga penyusunan PKRS & Laporan Kasus tuntas tanpa pusing.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a href="/biaya" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-teal-500 to-cyan-500 text-white font-bold text-sm shadow-xl shadow-teal-500/30 hover:shadow-cyan-500/50 hover:scale-105 active:scale-95 transition duration-200">
          <i class="fas fa-tags mr-2"></i> Lihat Daftar Harga (Pricelist)
        </a>
        <a href="/layanan" class="w-full sm:w-auto px-8 py-4 rounded-2xl glass-card text-slate-200 font-semibold text-sm hover:bg-white/10 hover:text-white transition duration-200">
          <i class="fas fa-layer-group mr-2 text-cyan-400"></i> Pelajari Layanan Modul
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        <div class="glass-card p-4 rounded-2xl">
          <div class="text-2xl font-black text-cyan-400">100%</div>
          <div class="text-[11px] text-slate-400 uppercase font-semibold mt-1">Kerahasiaan Akun</div>
        </div>
        <div class="glass-card p-4 rounded-2xl">
          <div class="text-2xl font-black text-teal-400">ICD-10</div>
          <div class="text-[11px] text-slate-400 uppercase font-semibold mt-1">Koding Gigi Tepat</div>
        </div>
        <div class="glass-card p-4 rounded-2xl">
          <div class="text-2xl font-black text-indigo-400">1 Hari</div>
          <div class="text-[11px] text-slate-400 uppercase font-semibold mt-1">Opsi Express Kilat</div>
        </div>
        <div class="glass-card p-4 rounded-2xl">
          <div class="text-2xl font-black text-pink-400">Valid</div>
          <div class="text-[11px] text-slate-400 uppercase font-semibold mt-1">Garansi Approval DP</div>
        </div>
      </div>

    </div>
  </section>

  <!-- PAGE 2: TENTANG JOKI BORANG PIDGI -->
  <section id="tentang" class="py-24 px-6 relative z-10">
    <div class="max-w-6xl mx-auto">
      <div class="glass-panel rounded-3xl p-8 sm:p-14 relative overflow-hidden border border-white/10">
        
        <div class="grid lg:grid-cols-12 gap-10 items-center">
          
          <div class="lg:col-span-7">
            <span class="inline-block px-3.5 py-1 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-300 font-bold text-xs uppercase tracking-wider mb-4">
              Tentang Layanan Kami
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight mb-6">
              Sahabat Administrasi Terbaik untuk Dokter Gigi Internsip
            </h2>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
              <strong>@jokiborangpidgi</strong> didirikan untuk memberikan solusi nyata bagi rekan-rekan sejawat dokter gigi yang tengah menjalani Program Internsip Dokter Gigi Indonesia (PIDGI).
            </p>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
              Kami menyadari padatnya jadwal pelayanan poli gigi, ekstraksi serial, jaga instalasi gawat darurat, hingga kegiatan lapangan UKGS/UKGMD yang menyita tenaga dan waktu istirahat Anda. Kami hadir mendampingi beban administratif Anda dengan pengerjaan logbook yang terstruktur, akurat, dan sesuai pedoman resmi Kemenkes.
            </p>
            
            <div class="flex flex-wrap gap-4 text-xs font-semibold text-slate-300">
              <div class="flex items-center gap-2 bg-white/5 px-3.5 py-2 rounded-xl border border-white/10">
                <i class="fas fa-check-circle text-teal-400"></i> Standar SOAP Klinis
              </div>
              <div class="flex items-center gap-2 bg-white/5 px-3.5 py-2 rounded-xl border border-white/10">
                <i class="fas fa-check-circle text-cyan-400"></i> Format Laporan Terstandar
              </div>
              <div class="flex items-center gap-2 bg-white/5 px-3.5 py-2 rounded-xl border border-white/10">
                <i class="fas fa-check-circle text-indigo-400"></i> Garansi Revisi
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 flex justify-center">
            <div class="w-full max-w-sm rounded-3xl p-6 glass-card border-cyan-500/30 relative">
              <div class="text-center pb-4 border-b border-white/10">
                <div class="w-20 h-20 mx-auto rounded-2xl bg-gradient-to-tr from-teal-500 to-cyan-400 p-[2px] mb-3 shadow-lg shadow-cyan-500/30">
                  <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center">
                    <img src="/img/jokiborang.png" alt="Profile Joki Borang PIDGI" class="w-full h-full object-cover rounded-[14px]" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'text-3xl\'>🦷</span>';">
                  </div>
                </div>
                <h3 class="font-bold text-white text-base">@jokiborangpidgi</h3>
                <p class="text-xs text-cyan-400 mt-0.5">Asisten Logbook Terpercaya</p>
              </div>
              <div class="pt-4 space-y-3 text-xs text-slate-300">
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">Target Pelayanan:</span>
                  <span class="font-semibold text-white">Stase RS & PKM</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">Kecepatan Respon:</span>
                  <span class="font-semibold text-teal-400">&lt; 15 Menit</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-slate-400">Privasi Akun Portal:</span>
                  <span class="font-semibold text-emerald-400">Terenkripsi 100%</span>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- PAGE 3: MENGAPA MEMILIH JOKIBORANGPIDGI -->
  <section id="keunggulan" class="py-24 px-6 relative z-10 bg-slate-950/40 border-y border-white/5">
    <div class="max-w-6xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="px-3.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 font-bold text-xs uppercase tracking-wider">
          Keunggulan Utama
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-4">
          Mengapa Memilih @jokiborangpidgi?
        </h2>
        <p class="text-slate-400 text-sm mt-3">
          Standar pengerjaan profesional yang mengutamakan ketelitian medis dan kenyamanan klien.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <div class="glass-card p-8 rounded-3xl">
          <div class="w-14 h-14 rounded-2xl bg-teal-500/20 text-teal-400 flex items-center justify-center text-2xl mb-6 shadow-inner">
            <i class="fas fa-tooth"></i>
          </div>
          <h3 class="font-bold text-lg text-white mb-2.5">Paham Istilah & Koding Gigi</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Tidak asal ketik. Kami memahami terminologi odontologi, penulisan status lokalis, prosedur konservasi, bedah mulut, serta koding ICD-10 gigi yang valid.
          </p>
        </div>

        <div class="glass-card p-8 rounded-3xl">
          <div class="w-14 h-14 rounded-2xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-2xl mb-6 shadow-inner">
            <i class="fas fa-user-shield"></i>
          </div>
          <h3 class="font-bold text-lg text-white mb-2.5">Kerahasiaan Data 100%</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Privasi akun e-Logbook, nama wahana, nomor registrasi pasien, dan identitas dokter internsip dijamin aman dengan protokol pembersihan data berkala.
          </p>
        </div>

        <div class="glass-card p-8 rounded-3xl">
          <div class="w-14 h-14 rounded-2xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-2xl mb-6 shadow-inner">
            <i class="fas fa-bolt"></i>
          </div>
          <h3 class="font-bold text-lg text-white mb-2.5">Pengerjaan Tepat Waktu</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Komitmen deadline ketat. Tersedia opsi Reguler (3-5 hari) hingga layanan Express (1x24 jam) saat menghadapi batas akhir monev bulanan.
          </p>
        </div>

        <div class="glass-card p-8 rounded-3xl">
          <div class="w-14 h-14 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-2xl mb-6 shadow-inner">
            <i class="fas fa-clipboard-check"></i>
          </div>
          <h3 class="font-bold text-lg text-white mb-2.5">Format Standar Approval DP</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Penyusunan format SOAP, kegiatan promkes, dan laporan evaluasi telah disesuaikan agar mudah diverifikasi dan disetujui Dokter Pendamping.
          </p>
        </div>

        <div class="glass-card p-8 rounded-3xl">
          <div class="w-14 h-14 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-2xl mb-6 shadow-inner">
            <i class="fas fa-tags"></i>
          </div>
          <h3 class="font-bold text-lg text-white mb-2.5">Biaya Fleksibel & Transparan</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Tersedia skema per kasus, paket mingguan, bulanan, hingga paket combo 6 bulan all-in dengan transparansi harga tanpa biaya tersembunyi.
          </p>
        </div>

        <div class="glass-card p-8 rounded-3xl">
          <div class="w-14 h-14 rounded-2xl bg-pink-500/20 text-pink-400 flex items-center justify-center text-2xl mb-6 shadow-inner">
            <i class="fas fa-headset"></i>
          </div>
          <h3 class="font-bold text-lg text-white mb-2.5">Konsultasi Ramah & Responsif</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Komunikasi mudah melalui WhatsApp langsung dengan admin yang mengerti alur sistem internsip dokter gigi di berbagai wahana Indonesia.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- PAGE 4: LAYANAN KAMI -->
  <section id="layanan" class="py-24 px-6 relative z-10">
    <div class="max-w-6xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="px-3.5 py-1 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-300 font-bold text-xs uppercase tracking-wider">
          Modul & Cakupan
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-4">
          Layanan Lengkap Logbook PIDGI
        </h2>
        <p class="text-slate-400 text-sm mt-3">
          Kami menangani seluruh pembagian stase Puskesmas dan Rumah Sakit secara menyeluruh.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8">
        
        <!-- PUSKESMAS -->
        <div class="glass-panel p-8 sm:p-10 rounded-3xl border border-teal-500/30 relative">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-2xl bg-teal-500/20 text-teal-400 flex items-center justify-center text-2xl">
              <i class="fas fa-clinic-medical"></i>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white">Logbook Stase Puskesmas</h3>
              <p class="text-xs text-teal-300 font-medium">Poli Gigi, Posyandu, & Pelayanan Masyarakat</p>
            </div>
          </div>

          <p class="text-slate-300 text-sm leading-relaxed mb-6">
            Pengelolaan menyeluruh untuk pemenuhan kuota tindakan di poli gigi puskesmas serta pelaporan kegiatan terpadu lintas sektor.
          </p>

          <div class="space-y-4">
            <div class="glass-card p-4 rounded-2xl flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-teal-500/20 text-teal-400 flex items-center justify-center text-xs font-bold mt-0.5">1</span>
              <div>
                <h4 class="text-sm font-bold text-white">UKP (Upaya Kesehatan Perseorangan)</h4>
                <p class="text-xs text-slate-400 mt-1">Input logbook kasus harian poli: ekstraksi, tumpatan (GIC/Komposit), scalling, premedikasi, serta edukasi pasien (KIE).</p>
              </div>
            </div>

            <div class="glass-card p-4 rounded-2xl flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-teal-500/20 text-teal-400 flex items-center justify-center text-xs font-bold mt-0.5">2</span>
              <div>
                <h4 class="text-sm font-bold text-white">UKM (Upaya Kesehatan Masyarakat)</h4>
                <p class="text-xs text-slate-400 mt-1">Penyusunan laporan Promkes lapangan, program UKGS di sekolah, penyuluhan posyandu, dan laporan evaluasi program puskesmas.</p>
              </div>
            </div>

            <div class="glass-card p-4 rounded-2xl flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-teal-500/20 text-teal-400 flex items-center justify-center text-xs font-bold mt-0.5">3</span>
              <div>
                <h4 class="text-sm font-bold text-white">Laporan Kasus (Lapsus) Puskesmas</h4>
                <p class="text-xs text-slate-400 mt-1">Penyusunan makalah laporan kasus komprehensif dari pasien poli gigi puskesmas lengkap dengan tinjauan teori terkini.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- RUMAH SAKIT -->
        <div class="glass-panel p-8 sm:p-10 rounded-3xl border border-cyan-500/30 relative">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-2xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-2xl">
              <i class="fas fa-hospital"></i>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white">Logbook Stase Rumah Sakit</h3>
              <p class="text-xs text-cyan-300 font-medium">Poli Spesialis, IGD, Manajemen & Penunjang</p>
            </div>
          </div>

          <p class="text-slate-300 text-sm leading-relaxed mb-6">
            Penyusunan administrasi klinis rumah sakit terintegrasi, laporan divisi manajemen mutu pelayanan, serta presentasi edukasi pasien.
          </p>

          <div class="space-y-4">
            <div class="glass-card p-4 rounded-2xl flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-xs font-bold mt-0.5">1</span>
