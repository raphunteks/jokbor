<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin CMS Dashboard - Joki Borang PIDGI</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              teal: '#0d9488',
              cyan: '#06b6d4',
              indigo: '#6366f1',
              dark: '#070b14',
              slate: '#0f172a'
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Admin Specific Styling */
    .admin-input {
      width: 100%;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #fff;
      padding: 0.6rem 0.875rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      transition: all 0.2s;
    }
    .admin-input:focus {
      outline: none;
      border-color: #06b6d4;
      box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.2);
    }
    .array-item-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 0.75rem;
      padding: 1rem;
      margin-bottom: 1rem;
      position: relative;
      transition: all 0.3s;
    }
    .array-item-card:hover {
      border-color: rgba(255, 255, 255, 0.15);
      background: rgba(255, 255, 255, 0.04);
    }
    .delete-btn {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      color: #f43f5e;
      background: rgba(244, 63, 94, 0.1);
      border: 1px solid rgba(244, 63, 94, 0.2);
      width: 2rem;
      height: 2rem;
      border-radius: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
    }
    .delete-btn:hover {
      background: #f43f5e;
      color: white;
    }
    .add-btn {
      width: 100%;
      padding: 0.75rem;
      border: 1px dashed rgba(6, 182, 212, 0.4);
      border-radius: 0.75rem;
      color: #06b6d4;
      background: rgba(6, 182, 212, 0.05);
      font-weight: 600;
      font-size: 0.875rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    .add-btn:hover {
      background: rgba(6, 182, 212, 0.1);
      border-style: solid;
    }
  </style>
</head>
<body class="bg-brand-dark text-slate-100 antialiased selection:bg-cyan-500 selection:text-white min-h-screen flex flex-col md:flex-row relative overflow-x-hidden">

  <div class="fixed inset-0 w-full h-full overflow-hidden pointer-events-none -z-10">
    <div class="mesh-glow mesh-teal w-[500px] h-[500px] absolute top-[-100px] left-[-100px]"></div>
    <div class="mesh-glow mesh-cyan w-[400px] h-[400px] absolute bottom-[-50px] right-[-50px]"></div>
  </div>

  <aside class="w-full md:w-72 glass-panel border-r border-white/10 md:min-h-screen flex flex-col sticky top-0 z-30 shadow-2xl">
    
    <div class="p-6 border-b border-white/10 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-teal-500 via-cyan-400 to-indigo-500 p-[1px] shadow-lg shadow-cyan-500/20 shrink-0">
          <div class="w-full h-full bg-slate-950 rounded-[15px] flex items-center justify-center overflow-hidden">
            <img src="/img/jokiborang.png" alt="Logo Admin Dashboard" class="w-full h-full object-cover transition duration-300" onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\\'text-xl\\'>⚙️</span>';">
          </div>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-base tracking-tight bg-gradient-to-r from-teal-300 via-cyan-200 to-white bg-clip-text text-transparent">
            Admin Panel
          </span>
          <span class="text-[10px] text-cyan-400 font-semibold tracking-wider uppercase">Vercel KV Redis CMS</span>
        </div>
      </div>
      
      <a href="/admin/logout" title="Logout" class="md:hidden w-9 h-9 rounded-xl bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 flex items-center justify-center border border-rose-500/20 transition">
        <i class="fas fa-power-off text-sm"></i>
      </a>
    </div>

    <nav class="flex-1 p-4 space-y-1.5 overflow-x-auto md:overflow-x-visible flex md:flex-col gap-1 md:gap-0 no-scrollbar">
      <button type="button" onclick="switchTab('brand')" id="tab-brand" class="tab-btn w-full text-left px-4 py-3 rounded-xl bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs sm:text-sm font-semibold shrink-0 transition flex items-center gap-3">
        <i class="fas fa-cog w-5 text-center"></i> <span>Info Utama Web</span>
      </button>

      <button type="button" onclick="switchTab('seo')" id="tab-seo" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 border border-transparent text-xs sm:text-sm font-semibold shrink-0 transition flex items-center gap-3">
        <i class="fas fa-search w-5 text-center"></i> <span>Manajemen SEO Meta</span>
      </button>

      <button type="button" onclick="switchTab('hero')" id="tab-hero" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 border border-transparent text-xs sm:text-sm font-semibold shrink-0 transition flex items-center gap-3">
        <i class="fas fa-home w-5 text-center"></i> <span>1. Hero Section</span>
      </button>

      <button type="button" onclick="switchTab('tentang')" id="tab-tentang" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 border border-transparent text-xs sm:text-sm font-semibold shrink-0 transition flex items-center gap-3">
        <i class="fas fa-info-circle w-5 text-center"></i> <span>2. Tentang Kami</span>
      </button>

      <button type="button" onclick="switchTab('keunggulan')" id="tab-keunggulan" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 border border-transparent text-xs sm:text-sm font-semibold shrink-0 transition flex items-center gap-3">
        <i class="fas fa-star w-5 text-center"></i> <span>3. Keunggulan (CRUD)</span>
      </button>

      <button type="button" onclick="switchTab('layanan')" id="tab-layanan" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 border border-transparent text-xs sm:text-sm font-semibold shrink-0 transition flex items-center gap-3">
        <i class="fas fa-layer-group w-5 text-center"></i> <span>4. Layanan Modul</span>
      </button>

      <button type="button" onclick="switchTab('testimoni')" id="tab-testimoni" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 border border-transparent text-xs sm:text-sm font-semibold shrink-0 transition flex items-center gap-3">
        <i class="fas fa-comments w-5 text-center"></i> <span>5. Testimoni (CRUD)</span>
      </button>

      <button type="button" onclick="switchTab('pricelist')" id="tab-pricelist" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 border border-transparent text-xs sm:text-sm font-semibold shrink-0 transition flex items-center gap-3">
        <i class="fas fa-tags w-5 text-center"></i> <span>6. Pricelist (CRUD)</span>
      </button>

      <button type="button" onclick="switchTab('faq')" id="tab-faq" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 border border-transparent text-xs sm:text-sm font-semibold shrink-0 transition flex items-center gap-3">
        <i class="fas fa-question-circle w-5 text-center"></i> <span>7. FAQ (CRUD)</span>
      </button>
    </nav>

    <div class="p-4 border-t border-white/10 hidden md:flex flex-col gap-2">
      <a href="/" target="_blank" class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 text-xs font-bold transition border border-white/10">
        <i class="fas fa-external-link-alt text-cyan-400"></i> Lihat Website Utama
      </a>
      <a href="/admin/logout" class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 text-xs font-bold transition border border-rose-500/20">
        <i class="fas fa-power-off"></i> Logout Admin
      </a>
    </div>
  </aside>

  <main class="flex-1 p-4 sm:p-6 md:p-10 overflow-y-auto relative z-10 w-full">
    <div class="max-w-5xl mx-auto space-y-6">
      
      <div class="glass-card p-6 rounded-3xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border border-white/10">
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
            <span>Management Content Studio</span>
          </h2>
          <p class="text-slate-400 text-xs mt-1">
            Sunting teks statis dan kelola daftar item (CRUD), lalu klik simpan untuk update realtime ke database Redis.
          </p>
        </div>

        <button type="button" id="saveBtn" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-gradient-to-r from-teal-500 to-cyan-500 text-white font-bold text-xs sm:text-sm shadow-xl shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:scale-105 active:scale-95 transition duration-200 flex items-center justify-center gap-2 shrink-0">
          <i class="fas fa-cloud-upload-alt text-base"></i>
          <span>Simpan Perubahan</span>
        </button>
      </div>

      <div id="statusAlert" class="hidden p-4 rounded-2xl text-xs font-semibold flex items-center justify-between transition-all">
        <div class="flex items-center gap-2.5">
          <i id="statusIcon" class="fas fa-info-circle text-base"></i>
          <span id="statusMessage">Status message</span>
        </div>
        <button onclick="document.getElementById('statusAlert').classList.add('hidden')" class="opacity-60 hover:opacity-100"><i class="fas fa-times"></i></button>
      </div>

      <div class="glass-card p-6 sm:p-8 rounded-3xl border border-white/10 relative">
        <form id="editorForm" onsubmit="return false;">
          
          <div id="form-brand" class="tab-content block space-y-5">
            <div class="border-b border-white/10 pb-4 mb-6">
              <h3 class="text-lg font-bold text-white flex items-center gap-2">
                <i class="fas fa-cog text-cyan-400"></i> <span>Pengaturan Utama Website (Header & Footer)</span>
              </h3>
            </div>

            <div class="space-y-4">
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1.5">Nama Brand/Web (Header)</label>
                  <input type="text" id="brand_title" data-path="brand.title" value="<%= content?.brand?.title || '' %>" class="admin-input">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1.5">Subtitle Brand (Header)</label>
                  <input type="text" id="brand_subtitle" data-path="brand.subtitle" value="<%= content?.brand?.subtitle || '' %>" class="admin-input">
                </div>
              </div>
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1.5">Teks Tombol WhatsApp Utama</label>
                  <input type="text" id="brand_ctaWhatsapp" data-path="brand.ctaWhatsapp" value="<%= content?.brand?.ctaWhatsapp || '' %>" class="admin-input">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1.5">Link Instagram (Footer)</label>
                  <input type="text" id="footer_instagram" data-path="footer.instagram" value="<%= content?.footer?.instagram || '' %>" class="admin-input">
                </div>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Teks Hak Cipta (Footer)</label>
                <textarea id="footer_copyText" data-path="footer.copyText" rows="2" class="admin-input"><%= content?.footer?.copyText || '' %></textarea>
              </div>
            </div>
          </div>

          <div id="form-seo" class="tab-content hidden space-y-5">
            <div class="border-b border-white/10 pb-4 mb-6">
              <h3 class="text-lg font-bold text-white flex items-center gap-2">
                <i class="fas fa-search text-cyan-400"></i> <span>Manajemen Metadata SEO (Semua Halaman)</span>
              </h3>
              <p class="text-[10px] text-slate-400 mt-1">Mengatur Meta Title, Description, dan Keywords untuk struktur Google Search Console di setiap halaman Clean URL.</p>
            </div>

            <div class="space-y-8">
              <% const pages = ['home', 'tentang', 'keunggulan', 'layanan', 'testimoni', 'biaya', 'faq']; %>
              <% pages.forEach(page => { %>
                <div class="p-4 rounded-xl border border-white/10 bg-white/5 space-y-3">
                  <h4 class="font-bold text-cyan-300 text-sm capitalize">Halaman: <%= page %></h4>
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <label class="block text-[10px] font-bold text-slate-400 mb-1">Meta Title</label>
                      <input type="text" data-path="seo.<%= page %>.title" value="<%= content?.seo?.[page]?.title || '' %>" class="admin-input text-xs">
                    </div>
                    <div>
                      <label class="block text-[10px] font-bold text-slate-400 mb-1">Keywords</label>
                      <input type="text" data-path="seo.<%= page %>.keywords" value="<%= content?.seo?.[page]?.keywords || '' %>" class="admin-input text-xs">
                    </div>
                  </div>
                  <div>
                    <label class="block text-[10px] font-bold text-slate-400 mb-1">Meta Description</label>
                    <textarea data-path="seo.<%= page %>.description" rows="2" class="admin-input text-xs"><%= content?.seo?.[page]?.description || '' %></textarea>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>

          <div id="form-hero" class="tab-content hidden space-y-5">
            <div class="border-b border-white/10 pb-4 mb-6">
              <h3 class="text-lg font-bold text-cyan-400 flex items-center gap-2">
                <i class="fas fa-home"></i> <span>Hero Section (Halaman Depan Utama)</span>
              </h3>
              <p class="text-xs text-slate-400 mt-0.5">Mengatur badge promosi, headline utama, dan paragraf pembuka di bagian paling atas.</p>
            </div>

            <div class="space-y-4">
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Badge Promosi (Teks Kecil Atas)</label>
                <input type="text" id="hero_badge" data-path="hero.badge" value="<%= content?.hero?.badge || '' %>" class="admin-input">
              </div>
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1.5">Headline Utama (Baris Atas Teks Putih)</label>
                  <input type="text" id="hero_titleMain" data-path="hero.titleMain" value="<%= content?.hero?.titleMain || '' %>" class="admin-input">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1.5">Headline Highlight (Teks Gradient)</label>
                  <input type="text" id="hero_titleHighlight" data-path="hero.titleHighlight" value="<%= content?.hero?.titleHighlight || '' %>" class="admin-input">
                </div>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Deskripsi Paragraf</label>
                <textarea id="hero_description" data-path="hero.description" rows="3" class="admin-input"><%= content?.hero?.description || '' %></textarea>
              </div>
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1.5">Teks Tombol CTA Harga</label>
                  <input type="text" id="hero_ctaPrice" data-path="hero.ctaPrice" value="<%= content?.hero?.ctaPrice || '' %>" class="admin-input">
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1.5">Teks Tombol CTA Layanan</label>
                  <input type="text" id="hero_ctaService" data-path="hero.ctaService" value="<%= content?.hero?.ctaService || '' %>" class="admin-input">
                </div>
              </div>
            </div>

            <div class="mt-8 border-t border-white/10 pt-6">
              <h4 class="text-sm font-bold text-cyan-400 mb-4">Statistik Card Bawah</h4>
              <div id="heroStats-container" class="grid sm:grid-cols-2 gap-4"></div>
              <button type="button" class="add-btn mt-4" onclick="addArrayItem('heroStats')"><i class="fas fa-plus"></i> Tambah Stats Baru</button>
            </div>
          </div>

          <div id="form-tentang" class="tab-content hidden space-y-5">
            <div class="border-b border-white/10 pb-4 mb-6">
              <h3 class="text-lg font-bold text-teal-400 flex items-center gap-2">
                <i class="fas fa-info-circle"></i> <span>Tentang Kami</span>
              </h3>
            </div>

            <div class="space-y-4">
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Badge Section</label>
                <input type="text" id="tentang_badge" data-path="tentang.badge" value="<%= content?.tentang?.badge || '' %>" class="admin-input">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Judul Section</label>
                <input type="text" id="tentang_title" data-path="tentang.title" value="<%= content?.tentang?.title || '' %>" class="admin-input">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Paragraf Pertama</label>
                <textarea id="tentang_p1" data-path="tentang.p1" rows="3" class="admin-input"><%= content?.tentang?.p1 || '' %></textarea>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Paragraf Kedua</label>
                <textarea id="tentang_p2" data-path="tentang.p2" rows="3" class="admin-input"><%= content?.tentang?.p2 || '' %></textarea>
              </div>
            </div>

            <div class="mt-8 border-t border-white/10 pt-6 space-y-4">
              <h4 class="text-sm font-bold text-teal-400 mb-4">Info Kartu Profil Kanan</h4>
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-[10px] font-bold text-slate-400 mb-1">Nama Handle (@)</label>
                  <input type="text" id="tentang_handle" data-path="tentang.profileCard.handle" value="<%= content?.tentang?.profileCard?.handle || '' %>" class="admin-input text-xs">
                </div>
                <div>
                  <label class="block text-[10px] font-bold text-slate-400 mb-1">Sub-title Profesi</label>
                  <input type="text" id="tentang_subhandle" data-path="tentang.profileCard.subhandle" value="<%= content?.tentang?.profileCard?.subhandle || '' %>" class="admin-input text-xs">
                </div>
                <div>
                  <label class="block text-[10px] font-bold text-slate-400 mb-1">Target Pelayanan (Value)</label>
                  <input type="text" id="tentang_target" data-path="tentang.profileCard.targetVal" value="<%= content?.tentang?.profileCard?.targetVal || '' %>" class="admin-input text-xs">
                </div>
                <div>
                  <label class="block text-[10px] font-bold text-slate-400 mb-1">Kecepatan Respon (Value)</label>
                  <input type="text" id="tentang_speed" data-path="tentang.profileCard.speedVal" value="<%= content?.tentang?.profileCard?.speedVal || '' %>" class="admin-input text-xs">
                </div>
                <div>
                  <label class="block text-[10px] font-bold text-slate-400 mb-1">Privasi (Value)</label>
                  <input type="text" id="tentang_privacy" data-path="tentang.profileCard.privacyVal" value="<%= content?.tentang?.profileCard?.privacyVal || '' %>" class="admin-input text-xs">
                </div>
              </div>
            </div>
          </div>

          <div id="form-keunggulan" class="tab-content hidden space-y-5">
            <div class="border-b border-white/10 pb-4 mb-6">
              <h3 class="text-lg font-bold text-indigo-400 flex items-center gap-2">
                <i class="fas fa-star"></i> <span>Keunggulan Utama</span>
              </h3>
            </div>

            <div class="space-y-4 mb-8">
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Badge Section</label>
                <input type="text" id="keunggulan_badge" data-path="keunggulan.badge" value="<%= content?.keunggulan?.badge || '' %>" class="admin-input">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Judul Section</label>
                <input type="text" id="keunggulan_title" data-path="keunggulan.title" value="<%= content?.keunggulan?.title || '' %>" class="admin-input">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Deskripsi Singkat</label>
                <textarea id="keunggulan_desc" data-path="keunggulan.desc" rows="2" class="admin-input"><%= content?.keunggulan?.desc || '' %></textarea>
              </div>
            </div>

            <div class="mt-8 border-t border-white/10 pt-6">
              <h4 class="text-sm font-bold text-white mb-4">Daftar Keunggulan (Card Item)</h4>
              <div id="keunggulan-container" class="space-y-3"></div>
              <button type="button" class="add-btn mt-4" onclick="addArrayItem('keunggulan')">
                <i class="fas fa-plus"></i> Tambah Item Keunggulan
              </button>
            </div>
          </div>

          <div id="form-layanan" class="tab-content hidden space-y-5">
            <div class="border-b border-white/10 pb-4 mb-6">
              <h3 class="text-lg font-bold text-cyan-400 flex items-center gap-2">
                <i class="fas fa-layer-group"></i> <span>Layanan & Modul Cakupan</span>
              </h3>
            </div>

            <div class="space-y-4 mb-8">
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Badge Section</label>
                <input type="text" id="layanan_badge" data-path="layanan.badge" value="<%= content?.layanan?.badge || '' %>" class="admin-input">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Judul Section</label>
                <input type="text" id="layanan_title" data-path="layanan.title" value="<%= content?.layanan?.title || '' %>" class="admin-input">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-300 mb-1.5">Deskripsi Singkat</label>
