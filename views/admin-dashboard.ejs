              </div>
            </div>

            <div class="mt-8 border-t border-white/10 pt-6">
              <h4 class="text-sm font-bold text-white mb-4">Daftar Pertanyaan & Jawaban</h4>
              <div id="faq-container" class="space-y-3"></div>
              <button type="button" class="add-btn mt-4" onclick="addArrayItem('faq')">
                <i class="fas fa-plus"></i> Tambah FAQ Baru
              </button>
            </div>
          </div>

        </form>
      </div>

    </div>
  </main>

  <script>
    // 1. Data Inisial dari Server EJS
    let currentData = <%- JSON.stringify(content) %>;
    
    // Konfigurasi Skema Array untuk Form Editor Dinamis
    const ARRAY_SCHEMAS = {
      'heroStats': { path: 'hero.stats', fields: [{id:'value', label:'Nilai Utama (Cth: 100%)', placeholder:''}, {id:'label', label:'Teks Deskripsi', placeholder:''}, {id:'color', label:'Warna Class Tailwind', placeholder:'text-cyan-400'}] },
      'keunggulan': { path: 'keunggulan.items', fields: [{id:'icon', label:'Ikon FontAwesome', placeholder:'fas fa-star'}, {id:'color', label:'Warna Class Tailwind', placeholder:'bg-teal-500/20 text-teal-400'}, {id:'title', label:'Judul Keunggulan', placeholder:''}, {id:'desc', label:'Deskripsi', isTextarea:true}] },
      'layanan-pkm': { path: 'layanan.pkm.modules', fields: [{id:'name', label:'Nama Modul', placeholder:''}, {id:'desc', label:'Deskripsi', isTextarea:true}] },
      'layanan-rs': { path: 'layanan.rs.modules', fields: [{id:'name', label:'Nama Modul', placeholder:''}, {id:'desc', label:'Deskripsi', isTextarea:true}] },
      'testimoni': { path: 'testimoni.items', fields: [{id:'initials', label:'Inisial (Max 2 Huruf)', placeholder:'RD'}, {id:'name', label:'Nama Dokter', placeholder:'drg. Fulan'}, {id:'wahana', label:'Nama Wahana/RS/PKM', placeholder:''}, {id:'color', label:'Warna Tema (Tailwind)', placeholder:'bg-teal-500/20 text-teal-300'}, {id:'comment', label:'Komentar Ulasan', isTextarea:true}] },
      'pricelist-ukm': { path: 'pricelist.ukm', fields: [{id:'name', label:'Nama Paket', placeholder:''}, {id:'price', label:'Harga', placeholder:'Rp 10.000'}, {id:'unit', label:'Unit (Opsional)', placeholder:'/laporan'}] },
      'pricelist-pkrs': { path: 'pricelist.pkrs', fields: [{id:'name', label:'Nama Paket', placeholder:''}, {id:'price', label:'Harga', placeholder:'Rp 40.000'}, {id:'note', label:'Catatan Kecil (Opsional)', placeholder:''}] },
      'pricelist-lapsus': { path: 'pricelist.lapsus', fields: [{id:'name', label:'Nama Paket', placeholder:''}, {id:'price', label:'Harga', placeholder:'Rp 100.000'}, {id:'note', label:'Catatan Kecil (Opsional)', placeholder:''}] },
      'offers': { path: 'offers', fields: [{id:'name', label:'Nama Offer', placeholder:''}, {id:'price', label:'Harga Int (Misal: 5000)', placeholder:''}, {id:'description', label:'Deskripsi Meta', placeholder:''}] },
      'faq': { path: 'faq.items', fields: [{id:'q', label:'Pertanyaan (Q)', placeholder:'1. Apa itu...'}, {id:'a', label:'Jawaban (A)', isTextarea:true}] }
    };

    // 2. Fungsi Helper (Mengatur Nilai Nested Object secara Dinamis)
    function resolvePath(obj, path) {
      return path.split('.').reduce((o, i) => o ? o[i] : null, obj);
    }
    
    function setPath(obj, path, value) {
      const parts = path.split('.');
      const last = parts.pop();
      const target = parts.reduce((o, i) => o[i] = o[i] || {}, obj);
      target[last] = value;
    }

    // 3. Merender DOM HTML untuk satu Item Data List (CRUD Card)
    function renderArrayItemHTML(type, index, itemData) {
      const schema = ARRAY_SCHEMAS[type];
      let html = `<div class="array-item-card" data-type="${type}" data-index="${index}">
        <button type="button" onclick="removeArrayItem(this)" class="delete-btn" title="Hapus"><i class="fas fa-trash"></i></button>
        <div class="space-y-3 pr-10">`; 
      
      schema.fields.forEach(field => {
        const val = itemData[field.id] || '';
        const fieldId = `arr_${type}_${index}_${field.id}`;
        
        html += `<div><label class="block text-[10px] font-bold text-slate-400 mb-1">${field.label}</label>`;
        if (field.isTextarea) {
          html += `<textarea id="${fieldId}" data-arrayfield="${field.id}" rows="2" class="admin-input text-xs py-1.5">${val}</textarea>`;
        } else {
          html += `<input type="text" id="${fieldId}" data-arrayfield="${field.id}" value="${val}" placeholder="${field.placeholder || ''}" class="admin-input text-xs py-1.5">`;
        }
        html += `</div>`;
      });
      
      html += `</div></div>`;
      return html;
    }

    // 4. Memuat Seluruh Array/List ke dalam Editor
    function initArrayRendering() {
      Object.keys(ARRAY_SCHEMAS).forEach(type => {
        const container = document.getElementById(`${type}-container`);
        if (!container) return;
        
        container.innerHTML = '';
        const dataArr = resolvePath(currentData, ARRAY_SCHEMAS[type].path) || [];
        
        dataArr.forEach((itemData, index) => {
          container.insertAdjacentHTML('beforeend', renderArrayItemHTML(type, index, itemData));
        });
      });
    }

    // 5. Action: Menambah Row Kosong Baru di Array (CRUD)
    function addArrayItem(type) {
      const container = document.getElementById(`${type}-container`);
      const currentIndex = container.children.length; 
      
      const emptyItem = {};
      ARRAY_SCHEMAS[type].fields.forEach(f => emptyItem[f.id] = '');
      
      container.insertAdjacentHTML('beforeend', renderArrayItemHTML(type, currentIndex, emptyItem));
    }

    // 6. Action: Menghapus Row dari DOM (CRUD)
    function removeArrayItem(buttonElement) {
      if(confirm('Apakah Anda yakin ingin menghapus baris data ini?')) {
        buttonElement.closest('.array-item-card').remove();
      }
    }

    // 7. Load Data Statis Pertama Kali saat halaman terbuka
    document.addEventListener('DOMContentLoaded', function() {
      // Data terisi oleh EJS value tag (Pre-populated HTML)
      // Kode JavaScript DOMContentLoaded untuk statik tidak lagi menimpa data
      initArrayRendering();
    });

    // 8. Tampilan Berpindah Tab Menu
    function switchTab(activeTabId) {
      document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden', 'block') && c.classList.remove('block'));
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/30');
        btn.classList.add('hover:bg-white/5', 'text-slate-300', 'border-transparent');
      });
      document.getElementById('form-' + activeTabId).classList.remove('hidden');
      document.getElementById('form-' + activeTabId).classList.add('block');
      const activeBtn = document.getElementById('tab-' + activeTabId);
      if(activeBtn) {
        activeBtn.classList.remove('hover:bg-white/5', 'text-slate-300', 'border-transparent');
        activeBtn.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/30');
      }
    }

    // 9. LOGIKA UTAMA: Pengumpulan (Ekstraksi) Seluruh Form HTML & Simpan ke REDIS Backend
    document.getElementById('saveBtn').addEventListener('click', async function(e) {
      e.preventDefault();
      const saveBtn = this;
      const originalBtnHTML = saveBtn.innerHTML;
      
      saveBtn.disabled = true;
      saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-base"></i> <span>Menyimpan ke Database...</span>';

      // Deep Clone Struktur JSON original
      let payloadData = JSON.parse(JSON.stringify(currentData));

      // 9.A: Rekam semua nilai Input yang bersfat Statis
      const staticInputs = document.querySelectorAll('input[data-path], textarea[data-path]');
      staticInputs.forEach(input => {
        setPath(payloadData, input.getAttribute('data-path'), input.value);
      });

      // 9.B: Rekam dan Susun Ulang Semua Field Array / Loop
      Object.keys(ARRAY_SCHEMAS).forEach(type => {
        const schema = ARRAY_SCHEMAS[type];
        const container = document.getElementById(`${type}-container`);
        if (container) {
          const newArray = [];
          const cards = container.querySelectorAll('.array-item-card');
          
          cards.forEach(card => {
            let itemObj = {};
            schema.fields.forEach(field => {
              const inputNode = card.querySelector(`[data-arrayfield="${field.id}"]`);
              if (inputNode) {
                itemObj[field.id] = inputNode.value;
              }
            });
            newArray.push(itemObj);
          });
          
          setPath(payloadData, schema.path, newArray); // Timpa node Array lama
        }
      });

      const statusAlert = document.getElementById('statusAlert');
      const statusIcon = document.getElementById('statusIcon');
      const statusMessage = document.getElementById('statusMessage');

      try {
        const response = await fetch('/admin/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payloadData)
        });

        const result = await response.json();
        statusAlert.classList.remove('hidden', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/30', 'bg-rose-500/20', 'text-rose-300', 'border-rose-500/30');

        if (result.success) {
          statusAlert.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border', 'border-emerald-500/30');
          statusIcon.className = 'fas fa-check-circle text-base';
          statusMessage.innerText = '✅ ' + result.message;
          currentData = payloadData; // Update lokal (tanpa direfresh)
        } else {
          throw new Error(result.message);
        }
      } catch (err) {
        statusAlert.classList.remove('hidden', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/30');
        statusAlert.classList.add('bg-rose-500/20', 'text-rose-300', 'border', 'border-rose-500/30');
        statusIcon.className = 'fas fa-exclamation-triangle text-base';
        statusMessage.innerText = '❌ Gagal: ' + err.message;
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalBtnHTML;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  </script>

</body>
</html>
