<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Joki Borang PIDGI</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="bg-brand-dark text-slate-100 min-h-screen flex flex-col md:flex-row">

  <aside class="w-full md:w-64 glass-panel border-r border-white/10 md:min-h-screen flex flex-col z-20 sticky top-0">
    <div class="p-6 border-b border-white/10 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-teal-500 to-cyan-400 p-[1px]">
          <div class="w-full h-full bg-slate-950 rounded-[11px] flex items-center justify-center text-lg">⚙️</div>
        </div>
        <div>
          <h1 class="font-bold text-white text-sm">Panel Admin</h1>
          <p class="text-[10px] text-cyan-400">Database Redis</p>
        </div>
      </div>
      <a href="/admin/logout" class="md:hidden text-rose-400 hover:text-rose-300"><i class="fas fa-power-off"></i></a>
    </div>

    <nav class="flex-1 p-4 overflow-y-auto space-y-2 flex md:flex-col gap-2 overflow-x-auto md:overflow-x-visible">
      <button onclick="switchTab('hero')" id="tab-hero" class="tab-btn w-full text-left px-4 py-3 rounded-xl bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs sm:text-sm font-semibold shrink-0 transition"><i class="fas fa-home w-5"></i> Hero Section</button>
      <button onclick="switchTab('tentang')" id="tab-tentang" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 text-xs sm:text-sm font-semibold shrink-0 transition"><i class="fas fa-info-circle w-5"></i> Tentang Kami</button>
      <button onclick="switchTab('keunggulan')" id="tab-keunggulan" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 text-xs sm:text-sm font-semibold shrink-0 transition"><i class="fas fa-star w-5"></i> Keunggulan</button>
      <button onclick="switchTab('layanan')" id="tab-layanan" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 text-xs sm:text-sm font-semibold shrink-0 transition"><i class="fas fa-layer-group w-5"></i> Layanan Modul</button>
      <button onclick="switchTab('testimoni')" id="tab-testimoni" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 text-xs sm:text-sm font-semibold shrink-0 transition"><i class="fas fa-comments w-5"></i> Testimoni</button>
      <button onclick="switchTab('pricelist')" id="tab-pricelist" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 text-xs sm:text-sm font-semibold shrink-0 transition"><i class="fas fa-tags w-5"></i> Pricelist</button>
      <button onclick="switchTab('faq')" id="tab-faq" class="tab-btn w-full text-left px-4 py-3 rounded-xl hover:bg-white/5 text-slate-300 text-xs sm:text-sm font-semibold shrink-0 transition"><i class="fas fa-question-circle w-5"></i> FAQ</button>
    </nav>

    <div class="p-4 border-t border-white/10 hidden md:block">
      <a href="/admin/logout" class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 text-sm font-bold transition border border-rose-500/20">
        <i class="fas fa-power-off"></i> Logout
      </a>
      <a href="/" target="_blank" class="flex items-center justify-center gap-2 w-full py-3 mt-2 rounded-xl bg-white/5 text-slate-300 hover:bg-white/10 text-sm font-bold transition border border-white/10">
        <i class="fas fa-external-link-alt"></i> Lihat Web
      </a>
    </div>
  </aside>

  <main class="flex-1 p-4 md:p-8 overflow-y-auto relative z-10">
    <div class="max-w-4xl mx-auto">
      <div class="flex justify-between items-center mb-8">
        <div>
          <h2 class="text-2xl font-extrabold text-white">Content Editor (CMS)</h2>
          <p class="text-slate-400 text-xs mt-1">Ubah data di sini, website akan otomatis terupdate realtime.</p>
        </div>
        <button id="saveBtn" class="bg-gradient-to-r from-teal-500 to-cyan-500 px-6 py-3 rounded-xl text-white font-bold text-sm shadow-lg shadow-cyan-500/30 hover:scale-105 active:scale-95 transition flex items-center gap-2">
          <i class="fas fa-save"></i> <span>Simpan Perubahan</span>
        </button>
      </div>

      <div class="glass-card p-6 md:p-8 rounded-3xl">
        <form id="editorForm" class="space-y-6">
          
          <div id="form-hero" class="tab-content block">
            <h3 class="text-lg font-bold text-cyan-400 border-b border-white/10 pb-3 mb-5"><i class="fas fa-home"></i> Hero / Beranda</h3>
            <div class="space-y-4">
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Badge Text</label> <input type="text" id="hero-badge" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Headline Utama (Putih)</label> <input type="text" id="hero-titleMain" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Headline Highlight (Gradient)</label> <input type="text" id="hero-titleHighlight" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Deskripsi Paragraf</label> <textarea id="hero-description" rows="4" class="admin-input"></textarea></div>
            </div>
          </div>

          <div id="form-tentang" class="tab-content hidden">
            <h3 class="text-lg font-bold text-teal-400 border-b border-white/10 pb-3 mb-5"><i class="fas fa-info-circle"></i> Tentang Kami</h3>
            <div class="space-y-4">
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Badge Text</label> <input type="text" id="tentang-badge" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Judul</label> <input type="text" id="tentang-title" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Paragraf 1</label> <textarea id="tentang-p1" rows="3" class="admin-input"></textarea></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Paragraf 2</label> <textarea id="tentang-p2" rows="4" class="admin-input"></textarea></div>
            </div>
          </div>

          <div id="form-keunggulan" class="tab-content hidden">
            <h3 class="text-lg font-bold text-indigo-400 border-b border-white/10 pb-3 mb-5"><i class="fas fa-star"></i> Header Keunggulan</h3>
            <div class="space-y-4">
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Badge Text</label> <input type="text" id="keunggulan-badge" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Judul</label> <input type="text" id="keunggulan-title" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Deskripsi</label> <textarea id="keunggulan-desc" rows="2" class="admin-input"></textarea></div>
            </div>
          </div>

          <div id="form-layanan" class="tab-content hidden">
            <h3 class="text-lg font-bold text-cyan-400 border-b border-white/10 pb-3 mb-5"><i class="fas fa-layer-group"></i> Header Layanan Modul</h3>
            <div class="space-y-4">
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Badge Text</label> <input type="text" id="layanan-badge" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Judul</label> <input type="text" id="layanan-title" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Deskripsi</label> <textarea id="layanan-desc" rows="2" class="admin-input"></textarea></div>
            </div>
          </div>

          <div id="form-testimoni" class="tab-content hidden">
            <h3 class="text-lg font-bold text-amber-400 border-b border-white/10 pb-3 mb-5"><i class="fas fa-comments"></i> Header Testimoni</h3>
            <div class="space-y-4">
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Badge Text</label> <input type="text" id="testimoni-badge" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Judul</label> <input type="text" id="testimoni-title" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Deskripsi</label> <textarea id="testimoni-desc" rows="2" class="admin-input"></textarea></div>
            </div>
          </div>

          <div id="form-pricelist" class="tab-content hidden">
            <h3 class="text-lg font-bold text-emerald-400 border-b border-white/10 pb-3 mb-5"><i class="fas fa-tags"></i> Header Pricelist</h3>
            <div class="space-y-4">
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Badge Text</label> <input type="text" id="pricelist-badge" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Judul</label> <input type="text" id="pricelist-title" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Deskripsi</label> <textarea id="pricelist-desc" rows="2" class="admin-input"></textarea></div>
            </div>
          </div>

          <div id="form-faq" class="tab-content hidden">
            <h3 class="text-lg font-bold text-rose-400 border-b border-white/10 pb-3 mb-5"><i class="fas fa-question-circle"></i> Header FAQ</h3>
            <div class="space-y-4">
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Badge Text</label> <input type="text" id="faq-badge" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Judul</label> <input type="text" id="faq-title" class="admin-input"></div>
              <div><label class="block text-xs font-bold text-slate-400 mb-2">Deskripsi</label> <textarea id="faq-desc" rows="2" class="admin-input"></textarea></div>
            </div>
          </div>

        </form>
      </div>

    </div>
  </main>

  <script>
    // Load Data JSON dari Backend EJS Injection
    const currentData = <%- JSON.stringify(content) %>;
    
    // Auto-Populate Inputs saat halaman dimuat
    document.addEventListener('DOMContentLoaded', () => {
      // Loop Object dan masukkan value ke input berdasarkan ID (format id: tab-key)
      Object.keys(currentData).forEach(tab => {
        Object.keys(currentData[tab]).forEach(key => {
          const el = document.getElementById(`${tab}-${key}`);
          if (el) el.value = currentData[tab][key];
        });
      });
    });

    // Fungsi Switching Tab Visual
    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(el => {
        el.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/30');
        el.classList.add('hover:bg-white/5', 'text-slate-300', 'border-transparent');
      });
      
      document.getElementById(`form-${tabId}`).classList.remove('hidden');
      
      const activeBtn = document.getElementById(`tab-${tabId}`);
      activeBtn.classList.remove('hover:bg-white/5', 'text-slate-300', 'border-transparent');
      activeBtn.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/30');
    }

    // Fungsi Ambil Data Dari Form dan Simpan
    document.getElementById('saveBtn').addEventListener('click', async (e) => {
      e.preventDefault();
      const btn = e.currentTarget;
      const originalText = btn.innerHTML;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Menyimpan...</span>';
      
      // Ambil seluruh object (sesuai struktur asli) lalu ganti isinya dengan value dari form
      const updatedData = JSON.parse(JSON.stringify(currentData)); 
      Object.keys(updatedData).forEach(tab => {
        Object.keys(updatedData[tab]).forEach(key => {
          const el = document.getElementById(`${tab}-${key}`);
          if (el) updatedData[tab][key] = el.value;
        });
      });

      try {
        const response = await fetch('/admin/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updatedData)
        });

        const result = await response.json();
        
        if (result.success) {
          alert('✅ Data Berhasil Disimpan ke Vercel Redis!');
        } else {
          alert('❌ Gagal: ' + result.message);
        }
      } catch (err) {
        alert('❌ Error Koneksi: ' + err.message);
      } finally {
        btn.innerHTML = originalText;
      }
    });
  </script>
</body>
</html>
